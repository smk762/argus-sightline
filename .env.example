# Files the API writes belong to you, not root (bash does not export UID).
UID=1000
GID=1000

# Ports (both bound to 127.0.0.1 unless *_BIND says otherwise).
UI_PORT=3107
SURVEY_PORT=8107
# UI_BIND=0.0.0.0
# SURVEY_BIND=0.0.0.0

# Point clouds/vectors (mounted read-only) and job output.
# SURVEY_IN_HOST=./data/in
# SURVEY_JOBS_HOST=./data/jobs

# 1 (default here): the UI runs steps. 0: browse jobs, maps, points and reports only.
SURVEY_ALLOW_PROCESS=1

# The API as the browser sees it. For a LAN/proxy origin, set this and widen SURVEY_CORS_ORIGINS
# to this UI's origin.
# ARGUS_SURVEY_URL=http://localhost:8107
# SURVEY_CORS_ORIGINS=http://localhost:3107

# Map backdrop: an XYZ raster tile template, or "none" (offline). Default: OpenStreetMap (light use).
# ARGUS_SURVEY_BASEMAP=none
# Attribution HTML for a custom basemap (OSM tiles get OSM's automatically):
# ARGUS_SURVEY_BASEMAP_ATTRIBUTION=
# ARGUS_STUDIO_URL=http://localhost:3000

# argus-survey checkout for `make up`, or a published image for `make up-published`.
# SURVEY_SRC=../argus-survey
# SURVEY_IMAGE=ghcr.io/smk762/argus-survey:latest

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
